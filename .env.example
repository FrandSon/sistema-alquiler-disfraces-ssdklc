# Clave criptográfica para firmar cookies de sesión y tokens Anti-CSRF (Generar con 64 caracteres hex)
FLASK_SECRET_KEY=reemplazar_por_cadena_hexadecimal_aleatoria_segura_de_64_caracteres # gitleaks:allow

# Cadena de conexión a PostgreSQL usando el driver psycopg2 y usuario de mínimo privilegio (RS-08)
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg2://atelier_app:AtelierPass#2026!@127.0.0.1:5432/alquiler_disfraces_db

# Configuración de expiración de sesión por inactividad en minutos (RS-04)
SESSION_TIMEOUT_MINUTES=30

# Cambiar a True cuando se despliegue en producción con certificado HTTPS/TLS (RS-11)
COOKIE_SECURE=False
